# Any OpenAI-compatible endpoint works. Pick ONE block and copy it to .env

# --- Groq (free tier, fast) -> https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b
# Optional, for the batch scripts (evaluation, data building): more keys, comma separated. When a
# key is rejected or out of daily quota the next one is used. Never needed for the web app.
# LLM_API_KEYS=second-key,third-key

# --- Google Gemini (free tier) -> https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# --- Ollama (fully local, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

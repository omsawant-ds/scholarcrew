# Copy this file to .env and add your Groq key (free, no card): https://console.groq.com/keys
LLM_API_KEY=your-groq-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional, for the batch scripts (evaluation, data building): more keys from other Groq accounts,
# comma separated. When a key is rejected or out of daily quota the next one is used. Keys on the
# same account share one quota, so only other accounts help. Never needed for the web app.
# LLM_API_KEYS=second-key,third-key
